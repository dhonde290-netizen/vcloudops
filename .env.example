# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this file to .env.local and fill in real values.
# .env.local is gitignored. NEVER commit real secrets to the repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site config ──────────────────────────────────────────────────────────────

# The public URL of the deployed site (no trailing slash).
# Used for OpenGraph metadata and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# ── Queries feature (Phase 3) ─────────────────────────────────────────────────

# Supabase project URL (found in: Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon (public) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key — SERVER SIDE ONLY. Never expose this in the browser.
# Used by the admin triage view to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Student queries form config (Phase 3) ────────────────────────────────────

# VIT email domain — submissions from other domains are rejected.
# Default: "vitstudent.ac.in". Override if the college changes its domain.
VIT_EMAIL_DOMAIN=vitstudent.ac.in

# Maximum queries per IP per hour (rate limiting)
QUERIES_RATE_LIMIT_PER_HOUR=3

# SLA shown on the success screen ("We'll reply within X days")
QUERIES_SLA_DAYS=3

# ── Admin auth (Phase 4) ──────────────────────────────────────────────────────

# Comma-separated list of team email addresses allowed to access /admin/queries
# Example: "president@vitstudent.ac.in,vp@vitstudent.ac.in"
ADMIN_EMAILS=
