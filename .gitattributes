# Normalize line endings to LF in the repo, check out as LF on all platforms.
# This prevents the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Binary files — never touch line endings
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.svg text eol=lf
*.woff2 binary
